# AI 测试官 · EdgeOne Makers 部署配置
# 复制本文件为 .env（.env 已被 gitignore，不会提交到仓库）

# ---------- 当前演示配置：阿里云百炼（阿里云官方大模型平台，公网可达）----------
# 通过 OpenAI 兼容接口调用，同时支持 Makers 沙箱（公网可达）和 AnyDev 本地
OPENAI_API_KEY="sk-***REMOVED***"
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
AI_GATEWAY_MODEL="kimi-k2.5"
# 判定类快模型（语义理解 / 覆盖度 / 需求审计 / 根因推理 / 自适应旁白）
AI_GATEWAY_SMALL_MODEL="deepseek-v3.2"

# ---------- EdgeOne Makers 内置模型网关（平台自动注入，留空即可）----------
# 部署时 CLI 会自动拉取真实值注入；本地 edgeone makers dev 也会带上来。
# 引擎优先用 OPENAI_*（若配置），否则回退 AI_GATEWAY_*（EdgeOne 免费额度）。
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# ---------- 引擎项目仓库地址（Makers 沙箱克隆用 · 部署关键）----------
# Makers 沙箱是空白环境，运行时需 git clone 本项目进去才能跑。
# 必须公开可 clone；评审测自己仓库时走前端「公开仓库 URL」输入框。
PROJECT_REPO_URL=

# ---------- 场景 A · PR/MR 自动回写闭环（可选）----------
# 配置后，加 --pr <MR的IID> 运行即可在工蜂 MR 下自动评论测试结果；
# 未配置则优雅降级为写 report/pr-comment.md（dry-run），离线 Demo 不受影响。
# TGIT_TOKEN=""
# TGIT_API_BASE="https://git.woa.com/api/v3"

# ---------- 场景 B · TAPD 需求/缺陷直连（可选）----------
# TAPD_API_USER=""
# TAPD_API_PASSWORD=""
# TAPD_WORKSPACE_ID=""

# ---------- 企微机器人推送（可选）----------
# WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx"

# ---------- 推送消息里的报告链接（可选）----------
# PUBLIC_BASE_URL="http://your-host:8088"

# ---------- 服务端并发上限（可选）----------
# MAX_CONCURRENCY=3
